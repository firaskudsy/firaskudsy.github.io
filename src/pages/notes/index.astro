---
import Base from '../../layouts/Base.astro';
import NotesList from '../../components/NotesList.astro';
import { copy, person, rssPath } from '../../data/site';
import { getNotes } from '../../lib/notes';

const notes = await getNotes();
---

<Base title={`${copy.notesTitle} | ${person.name}`} description={copy.notesIntro} current="notes" notesIndex>
  <section class="container page" aria-labelledby="notes-title">
    <div class="head">
      <h1 id="notes-title">{copy.notesTitle}</h1>
      <p class="muted">{copy.notesIntro}</p>
      <a href={rssPath} class="text-link">Subscribe by RSS</a>
    </div>
    <NotesList notes={notes} filters syncUrl />
  </section>
</Base>

<style>
  .page {
    padding-top: clamp(48px, 7vw, 88px);
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  h1 {
    font-size: clamp(40px, 5.4vw, 68px);
    line-height: 1.06;
    letter-spacing: -0.02em;
  }
</style>

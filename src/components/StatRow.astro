---
interface Stat {
  label: string;
  value: string;
  result: string;
  highlight?: boolean;
}
interface Props {
  stats: Stat[];
  caption?: string;
}
const { stats, caption } = Astro.props;
---

<figure class="stat-row">
  <ul class="stats" role="list">
    {stats.map((s) => (
      <li class="stat">
        <span class="label">{s.label}</span>
        <span class="value">{s.value}</span>
        <span class:list={['result', { highlight: s.highlight }]}>{s.result}</span>
      </li>
    ))}
  </ul>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  /* Inside a note body (22px gap) this gives the design's 36px from the text above. */
  figure.stat-row {
    margin: 14px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: var(--r-box);
    background: var(--card);
    line-height: 1.6;
  }
  .label {
    font-family: var(--f-body);
    font-size: 14.5px;
    color: var(--muted);
  }
  .value {
    font-family: var(--f-head);
    font-weight: 600;
    font-size: 28px;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .result {
    font-family: var(--f-body);
    font-size: 15.5px;
    font-weight: 600;
    color: var(--ink);
  }
  .highlight { color: var(--accent-ink); }
  figcaption {
    font-family: var(--f-body);
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--muted);
  }
</style>

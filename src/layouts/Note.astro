---
import Base from './Base.astro';
import SourceCard from '../components/SourceCard.astro';
import Giscus from '../components/Giscus.astro';
import { person } from '../data/site';
import { formatMonthYear, noteHref, readingMinutes, type Note } from '../lib/notes';

interface Props {
  note: Note;
  /** Newer neighbour in the list. */
  prev?: Note | undefined;
  /** Older neighbour in the list. */
  next?: Note | undefined;
}
const { note, prev, next } = Astro.props;
const { data } = note;
const minutes = readingMinutes(note.body);
const site = Astro.site ?? new URL('https://firaskudsy.github.io');

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  ...(data.updatedDate ? { dateModified: data.updatedDate.toISOString() } : {}),
  author: { '@type': 'Person', name: person.name, url: site.href },
  mainEntityOfPage: new URL(noteHref(note), site).href,
  keywords: data.tags.join(', '),
  ...(data.source ? { isBasedOn: data.source.url } : {}),
};
---

<Base
  title={`${data.title} | ${person.name}`}
  description={data.description}
  type="article"
  published={data.pubDate}
  modified={data.updatedDate}
  jsonLd={articleLd}
  current="notes"
>
  <article class="note" aria-labelledby="post-title">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/notes/">All articles</a>
      <span aria-hidden="true">/</span>
      <a href={`/notes/?topic=${encodeURIComponent(data.topic)}`}>{data.topic}</a>
    </nav>

    <h1 id="post-title">{data.title}</h1>

    <p class="byline">
      <span class="name">{person.name}</span>
      <time datetime={data.pubDate.toISOString().slice(0, 10)}>{formatMonthYear(data.pubDate)}</time>
      <span>{minutes} min read</span>
    </p>

    <div class="prose">
      <slot />
    </div>

    {data.source && <SourceCard {...data.source} />}

    {(data.tags.length > 0 || data.linkedin) && (
      <div class="tags-row">
        {data.tags.length > 0 && (
          <ul class="tags" role="list" aria-label="Tags">
            {data.tags.map((t) => <li>{t}</li>)}
          </ul>
        )}
        {data.linkedin && <a href={data.linkedin} class="text-link">Discuss on LinkedIn</a>}
      </div>
    )}

    <Giscus />

    {(prev || next) && (
      <nav class="more" aria-label="More articles">
        {prev ? (
          <a href={noteHref(prev)} class="more-link" rel="prev">
            <span class="more-label">Previous article</span>
            <span class="more-title">{prev.data.title}</span>
          </a>
        ) : (
          <span class="spacer" aria-hidden="true"></span>
        )}
        {next && (
          <a href={noteHref(next)} class="more-link right" rel="next">
            <span class="more-label">Next article</span>
            <span class="more-title">{next.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>
</Base>

<style>
  .note {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(32px, 5vw, 64px) var(--gutter) 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 500;
    color: var(--muted);
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .crumbs a:last-child { color: var(--accent-ink); }
  h1 {
    font-size: clamp(38px, 5vw, 60px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
    color: var(--muted);
  }
  .name {
    font-weight: 600;
    color: var(--ink);
  }

  /* Note body (Markdown) */
  .prose {
    display: flex;
    flex-direction: column;
    gap: 22px;
    font-family: var(--f-head);
    font-size: 20px;
    line-height: 1.7;
  }
  /* Direct children only, so components inside notes (StatRow etc.) keep their own layout. */
  .prose > :global(*) { margin: 0; }
  .prose > :global(ul),
  .prose > :global(ol) {
    padding-left: 1.3em;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .prose > :global(ul) > :global(li::marker),
  .prose > :global(ol) > :global(li::marker) { color: var(--muted); }
  .prose :global(p a),
  .prose :global(li a) {
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose > :global(h2),
  .prose > :global(h3) {
    font-size: 28px;
    line-height: 1.3;
    margin-top: 8px;
  }
  .prose > :global(blockquote) {
    padding-left: 18px;
    border-left: 3px solid var(--line);
    color: var(--muted);
  }
  .prose :global(p code),
  .prose :global(li code) {
    font-family: var(--f-mono);
    font-size: 0.82em;
    padding: 2px 6px;
    border-radius: var(--r-tag);
    background: var(--soft);
  }
  .prose > :global(pre) {
    padding: 16px 18px;
    border-radius: var(--r-box);
    overflow-x: auto;
    font-size: 15px;
  }
  .prose :global(p img) { border-radius: var(--r-box); }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    font-size: 14px;
    font-weight: 500;
    padding: 4px 10px;
    border-radius: var(--r-tag);
    background: var(--soft);
    color: var(--muted);
  }

  .more {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 24px;
    margin-top: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .more-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
  }
  .more-link:hover .more-title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .right { text-align: right; }
  .more-label {
    font-size: 15px;
    color: var(--muted);
  }
  .more-title {
    font-family: var(--f-head);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.3;
  }
  @media (max-width: 659.98px) {
    .spacer { display: none; }
    .right { text-align: left; }
  }
</style>
